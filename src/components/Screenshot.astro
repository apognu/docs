---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Zoom } from 'starlight-image-zoom/components';

interface Props {
	/** Path relative to `src/assets/`, e.g. `case-manager/configuration-1.png`. */
	src: string;
	alt?: string;
	/** Plain-text caption. For a caption with Markdown (e.g. inline code), put it between the tags instead. */
	caption?: string;
	/** Display width, e.g. `500px` or `75%`. The image file keeps its full resolution for zooming. */
	width?: string;
	bordered?: boolean;
}

const { src, alt = '', caption, width, bordered = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{png,jpg,jpeg,webp,gif}', { eager: true });
const image = images[`/src/assets/${src}`];

if (!image) {
	throw new Error(`<Screenshot>: no image at src/assets/${src} (used in ${Astro.url.pathname})`);
}

// The zoom plugin only wraps tags literally named <Image>, so wrap explicitly.
---

<figure class:list={['screenshot', { bordered }]} style={width ? `--image-width: ${width}` : undefined}>
	<Zoom label={alt || caption || ''}>
		<Image src={image.default} alt={alt || caption || ''} />
	</Zoom>
	{Astro.slots.has('default') ? <figcaption><slot /></figcaption> : caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.screenshot {
		margin-inline: auto;
		text-align: center;
	}

	.screenshot :global(starlight-image-zoom-zoomable) {
		display: block;
		width: fit-content;
		margin-inline: auto;
	}

	.screenshot :global(img) {
		width: var(--image-width, auto);
		max-width: 100%;
		height: auto;
	}

	.bordered :global(img) {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
	}

	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		font-style: italic;
		color: var(--sl-color-gray-3);
	}
</style>
