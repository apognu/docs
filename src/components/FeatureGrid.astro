---
interface Props {
	columns?: number;
}

const { columns = 2 } = Astro.props;
---

<div class="feature-grid not-content" style={`--columns: ${columns}`}>
	<slot />
</div>

<style>
	.feature-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.5rem 1rem;
	}

	@media (min-width: 50rem) {
		.feature-grid {
			grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
		}
	}
</style>
