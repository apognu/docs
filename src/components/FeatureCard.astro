---
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
	icon: string;
	href?: string;
	target?: string;
	isNew?: boolean;
	/** Bordered card with the icon above the title (ReadMe's `Card`), instead of the borderless `CardNoBorder` look. */
	bordered?: boolean;
	description?: string;
}

const { title, icon, href, target, isNew = false, bordered = false, description } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['feature-card', { bordered, link: href }]} href={href} target={target}>
	<div class="heading">
		<Icon name={icon} class="icon" aria-hidden="true" />
		<span class="title">{title}</span>
		{isNew && <span class="new">New</span>}
	</div>
	<div class="description">{description ?? <slot />}</div>
</Tag>

<style>
	.feature-card {
		display: block;
		padding: 0.75rem;
		border-radius: 0.375rem;
		color: inherit;
		text-decoration: none;
	}

	.feature-card.link:hover {
		background-color: var(--sl-color-gray-6);
	}

	.heading {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.icon {
		flex: none;
		font-size: 1.5rem;
		color: var(--sl-color-accent);
	}

	.title {
		flex: 1;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.new {
		flex: none;
		align-self: flex-start;
		padding: 0 0.4rem;
		border-radius: 0.75rem;
		background-color: var(--marble-primary);
		color: #eeedfe;
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		white-space: nowrap;
	}

	.description {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	.bordered {
		padding: 1.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}

	.bordered .heading {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.bordered .icon {
		color: var(--sl-color-gray-3);
	}

	.bordered .description {
		margin-top: 0.25rem;
	}
</style>
